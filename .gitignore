# Godot 캐시 —— 프로젝트를 열면 다시 만들어진다
solgukji_godot/.godot/
# Godot 실행 파일 (220MB) —— README 의 안내대로 받는다
tools/*.exe
tools/*.zip
# 점검 결과물
solgukji_godot/tests/out_*
# 파이썬
__pycache__/
*.pyc
# 안드로이드 빌드 도구 (JDK·SDK·Godot 내보내기 템플릿·내려받은 압축) —— tools/scripts/setup_android.ps1 로 받는다
tools/jdk17/
tools/android/
tools/editor_data/
tools/dl/
tools/_sc_
# 빌드 결과 —— APK 는 LFS 로 깃에 올린다 (11/6 사용자: 모바일에서 받으려고)
build/*
!build/solgukji.apk   # 11/12 사용자: 링크가 안 바뀌게 고정 이름 하나만 올린다 (버전은 게임 안 업데이트 내역에)
# 등급별 일러스트 참조 이미지 —— make_ref_sheet.py 로 언제든 다시 만든다
prompts/등급별/*/참조_*.png
# 등급별 일러스트 원본 시트 · 잘린 결과 (용량이 커서 깃에 넣지 않는다 —— 게임에 넣은 초상은 assets/portraits 에 있다)
references/등급별_시트/
# 등급별 v2 (기인 · 초월 · 불멸 · 신화) 참조 이미지 · 원본 시트 · 잘린 결과 —— 용량이 커서 깃에 넣지 않는다
prompts/등급별_v2/*/참조_*.png
references/등급별_v2_시트/
solgukji_godot/assets_src/polyhaven/*/
solgukji_godot/assets_src/mixamo/
references/얼굴썸네일/
assets_dl/
