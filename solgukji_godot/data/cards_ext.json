 "skill_cond": {
  "_설명": "일반 기술 발동 조건 (솔국지 확장, 2026-10-30) —— 원본은 차례마다 확률(RATE)로 발동했다. 이제 차례마다 그 확률만큼 '충전'이 쌓이고(처음 0.5, 최대 1), 다 차 있고 조건이 맞는 차례에 비용 없이 발동한다. 조건은 '|' 로 이으면 어느 하나만 맞아도 된다. always · hurt:x(자신 병력 x 이하) · ally_hurt:x(아군 하나라도 병력 x 이하) · foe_hurt:x(적 하나라도 병력 x 이하) · dense:n(한 열에 적 n 부대 이상) · front_n:n(적 맨 앞 열에 n 부대 이상) · foe_n:n(살아 있는 적 n 부대 이상) · line:열(그 열에 적이 있다) · no_st:상태(그 상태가 아닌 적이 있다) · ally_st(상태이상에 걸린 아군이 있다) · foe_morale(적 평균 사기가 아군 이상) · ally_morale:x(아군 평균 사기 x 이하)",
  "횡소천군": "front_n:2",
  "철벽방진": "hurt:0.8|ally_hurt:0.6",
  "필사돌격": "hurt:0.6",
  "일점돌파": "foe_hurt:0.6",
  "철기유린": "front_n:2",
  "우회돌격": "line:후군|line:중군",
  "일제사격": "dense:2",
  "화시난발": "no_st:burn",
  "저격": "always",
  "후미교란": "line:후군",
  "암습": "always",
  "독계": "no_st:plague",
  "화공": "dense:2",
  "수공": "foe_n:4",
  "팔문금쇄": "line:후군",
  "격려": "ally_hurt:0.85|foe_morale",
  "독려": "ally_hurt:0.7",
  "인덕": "ally_st|ally_hurt:0.6",
  "혹세": "foe_n:3",
  "역병": "foe_n:4",
  "저주": "always",
  "이간": "foe_morale",
  "봉계": "always",
  "밀계": "foe_n:3",
  "진두지휘": "ally_morale:90",
  "고함": "front_n:2|ally_morale:80",
  "격문": "ally_morale:90|foe_morale",
  "고취": "ally_hurt:0.7|ally_morale:80"
 },
